{
  "name": "crewcanvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:integrated": "node scripts/configure-local.mjs",
    "test:integrated": "node scripts/verify-integrated.mjs",
    "test:paypal-config": "node scripts/verify-paypal-config.mjs",
    "test:endpoint-security": "node scripts/verify-endpoint-security.mjs",
    "test:ai:prepare": "node scripts/verify-ai.mjs --prepare-only",
    "test:ai": "node scripts/verify-ai.mjs",
    "test:ai:preview": "node scripts/verify-ai-preview.mjs",
    "test:board": "node scripts/verify-board.mjs",
    "test:paypal-flow": "node scripts/verify-paypal-flow.mjs",
    "setup:reconcile": "node scripts/configure-reconciliation.mjs",
    "setup:paypal": "node scripts/setup-paypal.mjs",
    "configure:seller": "node scripts/configure-seller.mjs",
    "seed:integrated": "node --experimental-transform-types scripts/seed.mjs",
    "check:server": "deno check --config supabase/functions/deno.json supabase/functions/crew-api/index.ts supabase/functions/paypal-webhook/index.ts supabase/functions/reconcile/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@supabase/supabase-js": "2.80.0",
    "@tanstack/react-query": "5.90.6",
    "@xyflow/react": "12.8.6",
    "lucide-react": "0.552.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "deno": "2.9.6",
    "jsdom": "27.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
